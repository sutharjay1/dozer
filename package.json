{
  "name": "next-dozer",
  "version": "0.1.0",
  "description": "Keeps Next.js dev servers asleep until a page is requested, across every repo and worktree.",
  "keywords": [
    "nextjs",
    "next",
    "dev-server",
    "memory",
    "worktree",
    "turborepo",
    "monorepo",
    "cli"
  ],
  "homepage": "https://dozer-docs.sutharjay3635.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sutharjay1/dozer.git"
  },
  "bugs": {
    "url": "https://github.com/sutharjay1/dozer/issues"
  },
  "license": "MIT",
  "author": "Jay Suthar",
  "type": "module",
  "bin": {
    "dozer": "dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:e2e": "pnpm build && vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "playwright": "1.65.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
